# ============================================================================
# secapi environment configuration (example)
# Copy to `.env` (or set these in the container environment) and fill in values.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
APP_ENV=development                # development | production
DEBUG=false
ENABLE_DOCS=false                  # true to expose /docs, /redoc, /openapi.json (also on when DEBUG=true)
LOG_LEVEL=INFO
RATE_LIMIT=120/minute              # slowapi limit applied to endpoints (incl. /changes, /stream)

# --- CORS / hosts ----------------------------------------------------------
CORS_ORIGINS=                      # comma-separated origins; empty blocks cross-origin
ALLOWED_HOSTS=                     # comma-separated hostnames; empty disables the TrustedHost check

# --- External services -----------------------------------------------------
EDGAR_IDENTITY=you@example.com     # SEC EDGAR requires a contact identity
DEEPSEEK_API_KEY=                  # optional; enables /api/ai_summary

# --- Database (PostgreSQL) --------------------------------------------------
DB_HOST=localhost                  # in the deployed stack this is `sec-database`
DB_NAME=sec
DB_USER=postgres
DB_PASSWORD=                        # REQUIRED in production
DB_PORT=5432
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=10
DB_KEEPALIVE_IDLE=30
DB_POOL_MIN_CONN=4
DB_POOL_MAX_CONN=20

# --- Authentication (newsquawk-auth / Keycloak JWKS) -----------------------
# REQUIRED in production. Keycloak JWKS endpoint:
#   https://<keycloak>/realms/<realm>/protocol/openid-connect/certs
AUTH_JWKS_URL=
AUTH_AUDIENCE=                     # optional expected `aud`; empty = audience not checked
AUTH_JWKS_CACHE_LIFESPAN=300       # seconds to cache fetched keys
AUTH_JWKS_TIMEOUT=5.0              # seconds for the JWKS HTTP fetch
# Realm role a Keycloak service account must hold to read the sync endpoints
# (GET /changes, GET /changes/head).
AUTH_SYNC_REALM_ROLE=sec-sync
# Local dev/test ONLY — never enable in production. When AUTH_JWKS_URL is unset
# and APP_ENV != production, the app auto-falls back to stub mode.
AUTH_STUB_MODE=false
AUTH_STUB_SECRET=
